<Window x:Class="ArgTrack.Windows.Track.TrackGenericByteListDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ArgTrack.Converters"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:GenericByteListEditingViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="324" d:DesignHeight="530"
        Width="324" Height="530"
        Title="Track Section Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Left">
                <TextBlock>Editing</TextBlock>
                <TextBlock Text="{Binding ByteData.Count}"></TextBlock>
                <TextBlock>bytes</TextBlock>
            </TextBlock>

            <ListView Margin="5" ItemsSource="{Binding ByteData}" IsSynchronizedWithCurrentItem="True"
                      MouseDoubleClick="Control_OnMouseDoubleClick" Height="400">
                <!--<ListView.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding EditTrackSectionCommand}"
                                CommandParameter="{Binding ByteData/}"></KeyBinding>
                </ListView.InputBindings>-->
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Value" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Value}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="HexValue" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding HexValue}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>
</Window>
