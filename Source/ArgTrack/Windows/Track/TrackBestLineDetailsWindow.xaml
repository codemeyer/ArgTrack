<Window x:Class="ArgTrack.Windows.Track.TrackBestLineDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        xmlns:converters="clr-namespace:ArgTrack.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:BestLineSegmentViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="320" d:DesignHeight="280"
        Width="386" Height="280"
        Title="Computer Car Racing Line Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Type</Label>
                <ComboBox Width="120" Height="22" IsEnabled="{Binding CanEditType}"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value"
                          ItemsSource="{Binding AvailableBestLineTypes}" SelectedValue="{Binding SegmentType}"></ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Length</Label>
                <TextBox Width="60" Height="22" Text="{Binding Length}"></TextBox>
                <Label Margin="20,0,0,0" Width="100" Height="26" Content="{Binding LengthDescription}"></Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDisplacement}">
                <Label Width="180">Displacement</Label>
                <TextBox Width="60" Height="22" Text="{Binding Displacement}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowRadius}">
                <Label Width="180">Radius</Label>
                <TextBox Width="60" Height="22" Text="{Binding Radius}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCorrection}">
                <Label Width="180">Correction</Label>
                <TextBox Width="60" Height="22" Text="{Binding Correction}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowLowRadius}">
                <Label Width="180">Low Radius</Label>
                <TextBox Width="60" Height="22" Text="{Binding LowRadius}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowHighRadius}">
                <Label Width="180">High Radius</Label>
                <TextBox Width="60" Height="22" Text="{Binding HighRadius}"></TextBox>
            </StackPanel>

        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>
</Window>
