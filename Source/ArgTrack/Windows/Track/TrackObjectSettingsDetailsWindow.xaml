<Window x:Class="ArgTrack.Windows.Track.TrackObjectSettingsDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:TrackObjectSettingsViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="420" d:DesignHeight="380"
        Width="420" Height="380"
        Title="Track Object Settings Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Offset</Label>
                <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding Offset}"></TextBox>
                <Label Margin="10,0,0,0">Referenced in track cmd 0x80</Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Id</Label>
                <ComboBox Width ="260" ItemsSource="{Binding AvailableObjectIds}" Height="22"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding Id}"></ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowBillboardObjectDropdown}">
                <Label Width="120">Object</Label>
                <ComboBox ItemsSource="{Binding AvailableBillboardObjectIds}" Width="260" Height="22"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding AngleY}">
                </ComboBox>
            </StackPanel>


            <!--<StackPanel Orientation="Horizontal">
                <Label Width="120">Id</Label>
                <TextBox Width="60" Height="22" Text="{Binding Id}"></TextBox>
                <Label Margin="10,0,0,0">3D shape ID</Label>
            </StackPanel>-->

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowId2}">
                <Label Width="120">Id2</Label>
                <TextBox Width="60" Height="22" Text="{Binding Id2}"></TextBox>
                <Label Margin="10,0,0,0"></Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Unknown</Label>
                <TextBox Width="60" Height="22" Text="{Binding Unknown}"></TextBox>
                <Label Margin="10,0,0,0">Subitem selection and/or color?</Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowUnknown2}">
                <Label Width="120">Unknown2</Label>
                <TextBox Width="60" Height="22" Text="{Binding Unknown2}"></TextBox>
                <Label Margin="10,0,0,0">Draw-order related?</Label>
            </StackPanel>

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <Label Width="120">Distance from Track</Label>
                <TextBox Width="60" Height="22" Text="{Binding DistanceFromTrack}"></TextBox>
                <Label Margin="10,0,0,0">Neg. is left side, Pos. is right side</Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowAngleX}">
                <Label Width="120">Angle X</Label>
                <TextBox Width="60" Height="22" Text="{Binding AngleX}"></TextBox>
                <Label Margin="10,0,0,0"></Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowAngleY}">
                <Label Width="120">Angle Y</Label>
                <TextBox Width="60" Height="22" Text="{Binding AngleY}"></TextBox>
                <Label Margin="10,0,0,0"></Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Height</Label>
                <TextBox Width="60" Height="22" Text="{Binding Height}"></TextBox>
                <Label Margin="10,0,0,0"></Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Detail Level</Label>
                <TextBox Width="60" Height="22" Text="{Binding DetailLevel}"></TextBox>
                <Label Margin="10,0,0,0"></Label>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>
</Window>
