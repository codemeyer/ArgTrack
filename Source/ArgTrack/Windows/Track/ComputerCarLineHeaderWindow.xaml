<Window x:Class="ArgTrack.Windows.Track.ComputerCarLineHeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:TrackViewModel, IsDesignTimeCreatable=False}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Width="256" Height="160"
        Title="Racing Line Header">
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="5" Orientation="Vertical">

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Displacement</Label>
                    <TextBox Width="50" Height="22" Text="{Binding ComputerCarLineDisplacement}"></TextBox>
                </StackPanel>

            </StackPanel>

        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button Width="70" Height="23" Margin="0,0,5,0" Click="OKButton_Click">OK</Button>
            <Button Width="70" Height="23" Margin="0,0,12,0" Click="CancelButton_Click">Cancel</Button>
        </StackPanel>

    </Grid>
</Window>
