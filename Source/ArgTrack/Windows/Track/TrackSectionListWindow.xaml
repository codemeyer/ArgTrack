<Window x:Class="ArgTrack.Windows.Track.TrackSectionListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:TrackSectionDataListViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="900" Height="640"
        Title="Track Sections">
    <Grid Width="880" Height="590">
        <StackPanel Orientation="Vertical">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Button Width="100" Margin="5,0,0,0" Height="24"
                        Command="{Binding AddTrackSectionCommand}" CommandParameter="{Binding TrackSections}">
                    Add Section
                </Button>
                <Button Width="140" Margin="5,0,0,0" Height="24"
                        Command="{Binding InsertTrackSectionBeforeCommand}" CommandParameter="{Binding TrackSections}">
                    Insert Section Before
                </Button>
                <Button Width="140" Margin="5,0,0,0" Height="24"
                        Command="{Binding InsertTrackSectionAfterCommand}" CommandParameter="{Binding TrackSections}">
                    Insert Section After
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24"
                        Command="{Binding RemoveTrackSection}" CommandParameter="{Binding SelectedTrackSection}">
                    Delete Section
                </Button>
                <Button Width="32" Margin="3,0,0,0" Height="24"
                        Command="{Binding MoveTrackSectionUpCommand}" CommandParameter="{Binding SelectedTrackSection}">
                    <Button.ToolTip>Move Track Section Up</Button.ToolTip>
                    ▲
                </Button>
                <Button Width="32" Margin="3,0,0,0" Height="24"
                        Command="{Binding MoveTrackSectionDownCommand}" CommandParameter="{Binding SelectedTrackSection}">
                    <Button.ToolTip>Move Track Section Down</Button.ToolTip>
                    ▼
                </Button>
            </StackPanel>

            <ListView Height="520" Margin="5" ItemsSource="{Binding TrackSections}" IsSynchronizedWithCurrentItem="True"
                      MouseDoubleClick="Control_OnMouseDoubleClick" SelectedIndex="{Binding SelectedTrackSectionIndex}" SelectedItem="{Binding SelectedTrackSection}">
                <ListView.InputBindings>
                    <KeyBinding Key="Enter"
                            Command="{Binding EditTrackSectionCommand}"
                            CommandParameter="{Binding TrackSections/}"></KeyBinding>
                </ListView.InputBindings>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Index" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Index}">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding EditTrackSectionCommand}"
                                                      CommandParameter="{Binding}"></MouseBinding>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Length" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Length}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Height" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Height}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Curvature" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Curvature}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding CurvatureDescription}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Left Verge" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding LeftVergeWidth}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>


                        <GridViewColumn Header="Right Verge" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding RightVergeWidth}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Cmds#" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Commands.Count}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Description" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <!--<StackPanel Orientation="Horizontal" Margin="0,-5">
                <Label>Total Length:</Label>
                <Label Content="{Binding TotalLengthText}"></Label>
            </StackPanel>-->
        </StackPanel>
    </Grid>
</Window>
