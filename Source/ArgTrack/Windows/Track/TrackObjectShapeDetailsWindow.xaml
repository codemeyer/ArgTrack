<Window x:Class="ArgTrack.Windows.Track.TrackObjectShapeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        xmlns:converters="clr-namespace:ArgTrack.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:TrackObjectShapeViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="420" d:DesignHeight="594"
        Width="420" Height="594"
        Title="Track Object Shape Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <GroupBox Header="Description">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">HeaderIndex</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding DataIndex}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">DataIndex</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding DataIndex}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Object Data">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Header 1</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding HeaderValue1}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Offset 1</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding Offset1}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Header 2</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding HeaderValue2}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Offset 2</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding Offset2}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Header 3</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding HeaderValue3}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Offset 3</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding Offset3}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Header 4</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding HeaderValue4}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Offset 4</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding Offset4}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Header 5</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding HeaderValue5.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding HeaderValue5}"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Offset 5</Label>
                        <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding Offset5}"></TextBox>
                        <Label Margin="10,0,0,0"></Label>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Header 6</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding HeaderValue6.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding HeaderValue6}"></Button>
                    </StackPanel>



                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Data at Offset 1</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding OffsetData1.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding OffsetData1}"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Data at Offset 2</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding OffsetData2.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding OffsetData2}"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Data at Offset 3</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding OffsetData3.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding OffsetData3}"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Data at Offset 4</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding OffsetData4.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding OffsetData4}"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Width="120">Data at Offset 5</Label>
                        <TextBlock Width="60" Margin="0,5,0,0">
                            <TextBlock Text="{Binding OffsetData5.Length}"></TextBlock>
                            <TextBlock>bytes</TextBlock>
                        </TextBlock>
                        <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                                Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding OffsetData5}"></Button>
                    </StackPanel>

                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>
</Window>
