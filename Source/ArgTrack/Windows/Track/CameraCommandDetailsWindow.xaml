<Window x:Class="ArgTrack.Windows.CameraCommandDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:CameraCommandEditingViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="320" d:DesignHeight="280"
        Width="386" Height="280"
        Title="Camera Command Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <StackPanel Orientation="Horizontal">
                <Label Width="120">Type</Label>
                <ComboBox Width="120" Height="22" IsEnabled="{Binding CanEditType}"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value"
                          ItemsSource="{Binding AvailableCameraCommandTypes}" SelectedValue="{Binding CameraCommandType}"></ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCameraIndex}">
                <Label Width="180">Camera Index</Label>
                <TextBox Width="60" Height="22" Text="{Binding CameraIndex}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCameraIndexFrom}">
                <Label Width="180">Camera Index From</Label>
                <TextBox Width="60" Height="22" Text="{Binding CameraIndexFrom}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCameraIndexTo}">
                <Label Width="180">Camera Index To</Label>
                <TextBox Width="60" Height="22" Text="{Binding CameraIndexTo}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowAdjustment}">
                <Label Width="180">Adjustment</Label>
                <TextBox Width="60" Height="22" Text="{Binding Adjustment}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowTrackSide}">
                <Label Width="180">Track Side</Label>
                <ComboBox Width="60" Height="22"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value"
                          ItemsSource="{Binding AvailableTrackSides}" SelectedValue="{Binding TrackSide}"></ComboBox>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>

</Window>
