<Window x:Class="ArgTrack.Windows.Track.TrackLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:TrackHeaderViewModel, IsDesignTimeCreatable=False}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Width="580" Height="440"
        Title="Track Layout">
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="5" Orientation="Vertical">

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">First Section Angle</Label>
                    <TextBox Width="50" Height="22" Text="{Binding FirstSectionAngle}"></TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">First Section Height</Label>
                    <TextBox Width="50" Height="22" Text="{Binding FirstSectionHeight}"></TextBox>
                </StackPanel>

                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Label Width="180">Track Start Width</Label>
                    <TextBox Width="50" Height="22" Text="{Binding TrackStartWidth}"></TextBox>
                    <Label Margin="25,0,0,0" Width="165" Height="26" Content="{Binding TrackWidthDescription}"></Label>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Left Verge Start Width</Label>
                    <TextBox Width="50" Height="22" Text="{Binding LeftVergeStartWidth}"></TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Right Verge Start Width</Label>
                    <TextBox Width="50" Height="22" Text="{Binding RightVergeStartWidth}"></TextBox>
                </StackPanel>

                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Label Width="180">Surrounding Area</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableSurroundingAreas}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding SurroundingArea}" Width="90" Height="22" IsTabStop="True" />
                </StackPanel>

                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Label Width="180">Pole Side</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableTrackSides}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding PoleSide}" Width="90" Height="22" IsTabStop="True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Pits Side</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableTrackSides}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding PitsSide}" Width="90" Height="22" IsTabStop="True" />
                </StackPanel>

                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Label Width="180">Kerb Type</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbTypes}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding KerbType}" Width="90" Height="22" IsTabStop="True" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Height="20" VerticalAlignment="Center" Margin="20,0,0,0" HorizontalAlignment="Right">Example</TextBlock>
                        <Border BorderThickness="1" BorderBrush="Gray" Margin="5,0,0,0" HorizontalAlignment="Right" Height="20">
                            <StackPanel Orientation="Vertical">
                                <ItemsControl ItemsSource="{Binding UpperKerbExampleColorRectangles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding LowerKerbExampleColorRectangles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Kerb Upper Color</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbUpperColor}" Width="90" Height="22" IsTabStop="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Kerb Lower Color</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbLowerColor}" Width="90" Height="22" IsTabStop="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowKerbColor2}">
                    <Label Width="180">Kerb Upper Color 2</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbUpperColor2}" Width="90" Height="22" IsTabStop="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowKerbColor2}">
                    <Label Width="180">Kerb Lower Color 2</Label>
                    <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbLowerColor2}" Width="90" Height="22" IsTabStop="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button Width="70" Height="23" Margin="0,0,5,0" Click="OKButton_Click">OK</Button>
            <Button Width="70" Height="23" Margin="0,0,12,0" Click="CancelButton_Click">Cancel</Button>
        </StackPanel>

    </Grid>
</Window>
