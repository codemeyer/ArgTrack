<Window x:Class="ArgTrack.Windows.Track.CarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=track:CarSettingsViewModel, IsDesignTimeCreatable=False}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Width="256" Height="250"
        Title="Car Settings">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="5" Orientation="Vertical">

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Acceleration</Label>
                    <TextBox Width="50" Height="22" Text="{Binding Acceleration}"></TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Air Resistance</Label>
                    <TextBox Width="50" Height="22" Text="{Binding AirResistance}"></TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Fuel Load</Label>
                    <TextBox Width="50" Height="22" Text="{Binding FuelLoad}"></TextBox>
                    <!--<Label Margin="25,0,0,0" Width="165" Height="26" Content="{Binding TrackWidthDescription}"></Label>-->
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Grip Factor</Label>
                    <TextBox Width="50" Height="22" Text="{Binding GripFactor}"></TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Tyre Wear Qualifying</Label>
                    <TextBox Width="50" Height="22" Text="{Binding TyreWearQualifying}"></TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Width="180">Tyre Wear Non-Qualifying</Label>
                    <TextBox Width="50" Height="22" Text="{Binding TyreWearNonQualifying}"></TextBox>
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button Width="70" Height="23" Margin="0,0,5,0" Click="OKButton_Click">OK</Button>
            <Button Width="70" Height="23" Margin="0,0,12,0" Click="CancelButton_Click">Cancel</Button>
        </StackPanel>

    </Grid>
</Window>
