<Window x:Class="ArgTrack.Windows.Track.CameraCommandListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
        d:DataContext="{d:DesignInstance Type=track:CameraCommandListViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="Camera Commands"
        Width="590" Height="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid Width="575" Height="480">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <Button Width="100" Margin="5,0,0,0" Height="24"
                        Command="{Binding AddCameraCommandCommand}" CommandParameter="{Binding}">
                    Add
                </Button>
                <Button Width="100" Margin="5,0,0,0" Height="24"
                        Command="{Binding EditCameraCommandCommand}" CommandParameter="{Binding SelectedCameraCommand}">
                    Edit
                </Button>
                <!--<Button Width="140" Margin="5,0,0,0" Height="24"
                        Command="{Binding InsertCameraCommandBeforeCommand}" CommandParameter="{Binding CameraCommands}">
                    Insert Before
                </Button>
                <Button Width="140" Margin="5,0,0,0" Height="24"
                        Command="{Binding InsertCameraCommandAfterCommand}" CommandParameter="{Binding CameraCommands}">
                    Insert After
                </Button>-->
                <Button Width="100" Margin="3,0,0,0" Height="24"
                        Command="{Binding RemoveCameraCommandCommand}" CommandParameter="{Binding SelectedCameraCommand}">
                    Delete
                </Button>
                <!--<Button Width="32" Margin="3,0,0,0" Height="24"
                        Command="{Binding MoveTrackSectionUpCommand}" CommandParameter="{Binding SelectedTrackSection}">
                    <Button.ToolTip>Move Track Section Up</Button.ToolTip>
                    ▲
                </Button>
                <Button Width="32" Margin="3,0,0,0" Height="24"
                        Command="{Binding MoveTrackSectionDownCommand}" CommandParameter="{Binding SelectedTrackSection}">
                    <Button.ToolTip>Move Track Section Down</Button.ToolTip>
                    ▼
                </Button>-->
            </StackPanel>

            <ListView Width="565" Height="386" Margin="5" ItemsSource="{Binding CameraCommands}" IsSynchronizedWithCurrentItem="True"
                      MouseDoubleClick="Control_OnMouseDoubleClick" SelectedItem="{Binding SelectedCameraCommand}" SelectedIndex="{Binding SelectedCommandIndex}">
                <ListView.InputBindings>
                    <KeyBinding Key="Enter"
                            Command="{Binding EditCameraCommandCommand}"
                            CommandParameter="{Binding CameraCommands/}"></KeyBinding>
                </ListView.InputBindings>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Command" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding CommandDescription}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Data" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding CommandDataDescription}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CloseButton_OnClick"
                    Content="Close"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
