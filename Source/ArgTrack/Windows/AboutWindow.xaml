<Window x:Class="ArgTrack.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArgTrack.Windows"
        xmlns:viewModels="clr-namespace:ArgTrack.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AboutViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="520" d:DesignHeight="476"
        Width="520" Height="476"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="About ArgTrack">
    <Grid>
        <StackPanel Orientation="Vertical">

            <StackPanel Margin="5" Orientation="Horizontal">
                <Button HorizontalAlignment="Left" Width="140" Height="24" Margin="0"
                        Command="{Binding CheckForUpdateCommand}" CommandParameter="{Binding}">
                    Check for Updates
                </Button>
                <Label Visibility="{Binding VersionLatestLabel}">You are running the latest version!</Label>
                <Label Visibility="{Binding VersionUnableToRetrieveLabel}">Unable to retrieve version info!</Label>
                <TextBlock Visibility="{Binding VersionNewAvailable}">
                    <TextBlock>
                        <Label>New version available:</Label>
                        <Label Content="{Binding LatestVersion}"></Label>
                    </TextBlock>
                    <Hyperlink BaselineAlignment="Center" Command="{Binding OpenDownloadPageCommand}">Download!</Hyperlink>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <GroupBox Margin="5" Header="About">
                    <StackPanel Orientation="Vertical">
                        <TextBlock>
                                    <Label>ArgTrack</Label>
                                    <Label Content="{Binding CurrentVersion}"></Label>
                        </TextBlock>
                        <Label>Copyright © 2017-2019 Fredrik Meyer</Label>
                        <TextBlock Margin="5">
                                    Website: <Hyperlink Command="{Binding HelpDocsCommand}">www.argtools.com/argtrack</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="5" Header="Related Sites">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="5">
                                    ArgTools: <Hyperlink Command="{Binding OpenArgToolsSiteCommand}">www.argtools.com</Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="5,0,0,5">
                                    F1GP Fan Site: <Hyperlink Command="{Binding OpenFanSiteCommand}">sites.google.com/view/f1gpwc</Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="5,0">
                                    F1GP Google Group: <Hyperlink Command="{Binding OpenGoogleGroupSiteCommand}">groups.google.com/forum/#!forum/f1gpwc</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="5" Header="Credits">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="5" TextWrapping="Wrap">
                            René Smit - research material and Chequered Flag<LineBreak/>
                            Barrie Millar, Klaus Six - for Chequered Flag<LineBreak/>
                            Kristóf Kály-Kullai - for F1GP DOS Track editor<LineBreak />
                            Paul Hoad - for the GP2 Track Editor<LineBreak/>
                            Hrvoje Štimac - various research material<LineBreak />
                            Maxime Labelle, Adrian Walti, Martijn Keizer, et al<LineBreak />
                            <LineBreak/>
                            <!--ArgTrack is powered by the <Hyperlink Command="{Binding OpenArgDataPageCommand}">ArgData API</Hyperlink><LineBreak/>
                            <LineBreak/>-->
                            Various icons made by Freepik from www.flaticon.com
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Width="80" Height="23" IsDefault="True" Click="OKButton_OnClick">OK</Button>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
