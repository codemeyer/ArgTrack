<Window x:Class="ArgTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArgTrack"
        xmlns:tracks="clr-namespace:ArgTrack.UserControls.Tracks"
        xmlns:userControls="clr-namespace:ArgTrack.UserControls"
        WindowStartupLocation="Manual"
        mc:Ignorable="d"
        Icon="Resources/argtrack.ico"
        Title="ArgTrack"
        MinWidth="990" MinHeight="716"
        Width="990" Height="716">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadTrackCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveTrackCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="F4" Modifiers="Alt" Command="{Binding ExitApplicationCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
        <!--<KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoBrokerCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoBrokerCommand}" CommandParameter="{Binding}"></KeyBinding>-->
    </Window.InputBindings>
    <Grid Margin="0" Background="#204161">
