<UserControl x:Class="ArgTrack.UserControls.Tracks.TrackTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:track="clr-namespace:ArgTrack.ViewModels.Track"
             xmlns:tracks1="clr-namespace:ArgTrack.UserControls.Tracks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=track:TrackTabViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="1000" d:DesignHeight="700">
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Width="100" Height="24" Margin="0"
                        Command="{Binding LoadTrackCommand}" CommandParameter="{Binding}">
                    Load Track
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24"
                        Command="{Binding SaveTrackCommand}" CommandParameter="{Binding}">
                    Save Track
                </Button>
                <!--<Button Width="100" Margin="3,0,0,0" Height="24"
                        Command="{Binding ValidateTrackCommand}" CommandParameter="{Binding}">
                    Validate Track
                </Button>
                <Button Width="120" Margin="3,0,0,0" Height="24"
                        Command="{Binding ConvertTrackCommand}" CommandParameter="{Binding}">
                    Convert GP2 Track
                </Button>-->

                <Button Width="100" Margin="5,0,0,0" Height="24" Visibility="{Binding ShowTrackSectionActionButtons}"
                        Command="{Binding AddTrackSectionCommand}" CommandParameter="{Binding Track.TrackSections}">
                    Add Section
                </Button>
                <Button Width="100" Margin="5,0,0,0" Height="24" Visibility="{Binding ShowTrackSectionActionButtons}"
                        Command="{Binding InsertTrackSectionCommand}" CommandParameter="{Binding Track}">
                    Insert Section
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24" Visibility="{Binding ShowTrackSectionActionButtons}"
                        Command="{Binding DeleteTrackSectionCommand}" CommandParameter="{Binding Track}">
                    Delete Section
                </Button>

                <Button Width="100" Margin="5,0,0,0" Height="24" Visibility="{Binding ShowPitLaneSectionActionButtons}"
                        Command="{Binding AddTrackSectionCommand}" CommandParameter="{Binding Track.PitLaneSections}">
                    Add Section
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24" Visibility="{Binding ShowPitLaneSectionActionButtons}"
                        Command="{Binding DeletePitLaneSectionCommand}" CommandParameter="{Binding Track}">
                    Delete Section
                </Button>

                <Button Width="100" Margin="5,0,0,0" Height="24" Visibility="{Binding ShowBestLineActionButtons}"
                        Command="{Binding AddBestLineSegmentCommand}" CommandParameter="{Binding Track.BestLineSegments}">
                    Add Section
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24" Visibility="{Binding ShowBestLineActionButtons}"
                        Command="{Binding DeleteBestLineSegmentCommand}" CommandParameter="{Binding Track}">
                    Delete Section
                </Button>

                <!--<Button Width="100" Margin="3,0,0,0" Height="24" Visibility="{Binding ShowObjectSettingsActionButtons}"
                        Command="{Binding AddObjectSettingsCommand}" CommandParameter="{Binding Track}">
                    Add Object
                </Button>-->

                <Button Width="100" Margin="5,0,0,0" Height="24" Visibility="{Binding ShowHorizonActionButtons}"
                        Command="{Binding UpdateHorizonFromFileCommand}" CommandParameter="{Binding Track}">
                    Load Horizon
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24" Visibility="{Binding ShowHorizonActionButtons}"
                        Command="{Binding SaveHorizonToFileCommand}" CommandParameter="{Binding Track}">
                    Save Horizon
                </Button>
            </StackPanel>

            <TabControl Margin="5" SelectedIndex="{Binding SelectedTrackTabIndex}">
                <TabItem>
                    <TabItem.Header>
                        Misc
                    </TabItem.Header>
                    <tracks1:TrackHeaderUserControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DataContext="{Binding Track.TrackHeader}"></tracks1:TrackHeaderUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Sections
                    </TabItem.Header>
                    <tracks1:TrackSectionsUserControl DataContext="{Binding Track}"></tracks1:TrackSectionsUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Pit Lane
                    </TabItem.Header>
                    <tracks1:TrackPitLaneSectionsUserControl DataContext="{Binding Track}"></tracks1:TrackPitLaneSectionsUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Best Line
                    </TabItem.Header>
                    <tracks1:TrackBestLineUserControl DataContext="{Binding Track}"></tracks1:TrackBestLineUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Object Settings
                    </TabItem.Header>
                    <tracks1:TrackObjectSettingsUserControl DataContext="{Binding Track}"></tracks1:TrackObjectSettingsUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Object Shapes
                    </TabItem.Header>
                    <tracks1:TrackObjectShapesUserControl DataContext="{Binding Track}"></tracks1:TrackObjectShapesUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Horizon
                    </TabItem.Header>
                    <tracks1:TrackHorizonUserControl DataContext="{Binding Track}"></tracks1:TrackHorizonUserControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        Setup
                    </TabItem.Header>
                    <tracks1:TrackSetupUserControl DataContext="{Binding Track}"></tracks1:TrackSetupUserControl>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</UserControl>
