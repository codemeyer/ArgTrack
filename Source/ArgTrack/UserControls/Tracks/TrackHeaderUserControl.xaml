<UserControl x:Class="ArgTrack.UserControls.Tracks.TrackHeaderUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="880" d:DesignHeight="590">
    <Grid Width="880" Height="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5" Orientation="Vertical">

            <StackPanel Orientation="Horizontal">
                <Label Width="180">First Section Angle</Label>
                <TextBox Width="50" Height="22" Text="{Binding FirstSectionAngle}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">First Section Height</Label>
                <TextBox Width="50" Height="22" Text="{Binding FirstSectionHeight}"></TextBox>
            </StackPanel>

            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label Width="180">Track Center X</Label>
                <TextBox Width="50" Height="22" Text="{Binding TrackCenterX}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Track Center Y</Label>
                <TextBox Width="50" Height="22" Text="{Binding TrackCenterY}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Track Center Z</Label>
                <TextBox Width="50" Height="22" Text="{Binding TrackCenterZ}"></TextBox>
            </StackPanel>

            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label Width="180">Track Start Width</Label>
                <TextBox Width="50" Height="22" Text="{Binding TrackStartWidth}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Left Verge Start Width</Label>
                <TextBox Width="50" Height="22" Text="{Binding LeftVergeStartWidth}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Right Verge Start Width</Label>
                <TextBox Width="50" Height="22" Text="{Binding RightVergeStartWidth}"></TextBox>
            </StackPanel>

            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label Width="180">Surrounding Area</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableSurroundingAreas}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding SurroundingArea}" Width="90" Height="22" IsTabStop="True" />
            </StackPanel>

            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label Width="180">Pole Side</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableTrackSides}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding PoleSide}" Width="90" Height="22" IsTabStop="True" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Pits Side</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableTrackSides}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding PitsSide}" Width="90" Height="22" IsTabStop="True" />
            </StackPanel>

            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label Width="180">Kerb Type</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbTypes}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding KerbType}" Width="90" Height="22" IsTabStop="True" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Kerb Fixed Upper Color</Label>
                <Rectangle Width="90" Height="22" Stroke="Gray" StrokeThickness="1"
                           Fill="#FFFFEE" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Kerb Fixed Lower Color</Label>
                <Rectangle Width="90" Height="22" Stroke="Gray" StrokeThickness="1"
                           Fill="#DFDED2" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Kerb Upper Color</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbUpperColor}" Width="90" Height="22" IsTabStop="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Kerb Lower Color</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbLowerColor}" Width="90" Height="22" IsTabStop="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowKerbColor2}">
                <Label Width="180">Kerb Upper Color 2</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbUpperColor2}" Width="90" Height="22" IsTabStop="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowKerbColor2}">
                <Label Width="180">Kerb Lower Color 2</Label>
                <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbColors}" SelectedValuePath="Value" SelectedValue="{Binding KerbLowerColor2}" Width="90" Height="22" IsTabStop="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="50" Height="16"
                                           Background="{Binding DisplayValue}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>


        </StackPanel>


        <StackPanel Grid.Column="1" Margin="5" Orientation="Vertical">

            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <Label Width="180">Offset UnknownLong1</Label>
                <TextBox Width="80" Height="22" IsReadOnly="True" Text="{Binding UnknownLong1}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <Label Width="180">Offset UnknownLong2</Label>
                <TextBox Width="80" Height="22" IsReadOnly="True" Text="{Binding UnknownLong2}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <Label Width="180">Offset ChecksumPosition</Label>
                <TextBox Width="50" Height="22" IsReadOnly="True" Text="{Binding ChecksumPosition}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <Label Width="180">Offset ObjectData</Label>
                <TextBox Width="50" Height="22" IsReadOnly="True" Text="{Binding ObjectData}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <Label Width="180">Offset TrackData</Label>
                <TextBox Width="50" Height="22" IsReadOnly="True" Text="{Binding TrackData}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="180">Data after setup</Label>
                <TextBlock Width="60" Margin="0,5,0,0">
                    <TextBlock Text="{Binding DataAfterSetup.Count}"></TextBlock>
                    <TextBlock>bytes</TextBlock>
                </TextBlock>
                <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                        Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding DataAfterSetup}"></Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Final data 1</Label>
                <TextBlock Width="60" Margin="0,5,0,0">
                    <TextBlock Text="{Binding FinalData1.Count}"></TextBlock>
                    <TextBlock>bytes</TextBlock>
                </TextBlock>
                <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                        Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding FinalData1}"></Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Final data 2</Label>
                <TextBlock Width="60" Margin="0,5,0,0">
                    <TextBlock Text="{Binding FinalData2.Count}"></TextBlock>
                    <TextBlock>bytes</TextBlock>
                </TextBlock>
                <Button Width="60" Margin="5,0,0,0" Height="20" Content="Edit"
                        Command="{Binding EditGenericByteDataCommand}" CommandParameter="{Binding FinalData2}"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
