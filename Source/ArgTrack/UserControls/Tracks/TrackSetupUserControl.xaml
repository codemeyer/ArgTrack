<UserControl x:Class="ArgTrack.UserControls.Tracks.TrackSetupUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArgTrack.ViewModels.Track"
             xmlns:carSetup="clr-namespace:ArgTrack.UserControls.CarSetup"
             mc:Ignorable="d" 
             d:DesignWidth="880" d:DesignHeight="590">
    <Grid Width="880" Height="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <carSetup:CarSetupUserControl DataContext="{Binding ComputerCarSetup}" Grid.Column="0"></carSetup:CarSetupUserControl>
    </Grid>
</UserControl>
