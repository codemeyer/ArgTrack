<UserControl x:Class="ArgTrack.UserControls.CarSetup.CarSetupPairUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ArgTrack.UserControls.CarSetup"
             xmlns:carSetup="clr-namespace:ArgTrack.UserControls.CarSetup"
             mc:Ignorable="d"
             d:DesignHeight="440" d:DesignWidth="780">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Setup1Description}"></Label>
                </StackPanel>
                <carSetup:CarSetupUserControl DataContext="{Binding RaceSetup}"></carSetup:CarSetupUserControl>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Width="90" Height="24"
                            Command="{Binding LoadSingleSetupFileCommand}"
                            CommandParameter="{Binding RaceSetup}">
                        Load Setup
                    </Button>
                    <Button Width="90" Height="24" Margin="3,0,0,0"
                            Command="{Binding SaveSingleSetupFileCommand}"
                            CommandParameter="{Binding RaceSetup}">
                        Save Setup
                    </Button>
                    <Button Visibility="{Binding ShowSetup2}" Width="140" Height="24" Margin="3,0,0,0"
                            Command="{Binding CopyRaceSetupToQualifyingCommand}"
                            CommandParameter="{Binding}">
                        Copy to Qualifying &gt;
                    </Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowSetup2}" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Setup2Description}"></Label>
                </StackPanel>
                <carSetup:CarSetupUserControl DataContext="{Binding QualifyingSetup}"></carSetup:CarSetupUserControl>
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Left">
                    <Button Visibility="{Binding ShowSetup2}" Width="140" Height="24"
                            Command="{Binding CopyQualifyingSetupToRaceCommand}"
                            CommandParameter="{Binding}">
                        &lt; Copy to Race
                    </Button>
                    <Button Width="90" Height="24" Margin="3,0,0,0"
                            Command="{Binding LoadSingleSetupFileCommand}"
                            CommandParameter="{Binding QualifyingSetup}">
                        Load Setup
                    </Button>
                    <Button Width="90" Height="24" Margin="3,0,0,0"
                            Command="{Binding SaveSingleSetupFileCommand}"
                            CommandParameter="{Binding QualifyingSetup}">
                        Save Setup
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
