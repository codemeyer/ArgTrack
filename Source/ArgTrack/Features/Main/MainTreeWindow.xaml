<Window x:Class="ArgTrack.Features.Main.MainTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:trackSection="clr-namespace:ArgTrack.Features.TrackEditing.TrackSection"
        xmlns:racingLine="clr-namespace:ArgTrack.Features.TrackEditing.RacingLine"
        xmlns:objectSettings="clr-namespace:ArgTrack.Features.TrackEditing.ObjectSettings"
        xmlns:objectShapes="clr-namespace:ArgTrack.Features.TrackEditing.ObjectShapes"
        xmlns:main="clr-namespace:ArgTrack.Features.Main"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=main:MainViewModel, IsDesignTimeCreatable=True}"
        Icon="../../Resources/argtrack.ico"
        ResizeMode="CanResizeWithGrip"
        SizeChanged="MainTreeWindow_OnSizeChanged"
        Width="1200" Height="880"
        MinWidth="800" MinHeight="600"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="ArgTrack">
    <Window.Resources>
        <main:TreeViewIconEnumToImageConverter x:Key="IconEnumToImageConverter"></main:TreeViewIconEnumToImageConverter>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadTrackCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveTrackCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="F4" Modifiers="Alt" Command="{Binding ExitApplicationCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding TrackLayoutViewModel.ZoomTrackViewInCommand}" CommandParameter="{Binding TrackLayoutViewModel}"></KeyBinding>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding TrackLayoutViewModel.ZoomTrackViewOutCommand}" CommandParameter="{Binding TrackLayoutViewModel}"></KeyBinding>
    </Window.InputBindings>
    <Grid Margin="0">
        <Menu HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Command="{Binding LoadTrackCommand}" CommandParameter="{Binding}"></MenuItem>
                <MenuItem Header="_Save" Command="{Binding SaveTrackCommand}" CommandParameter="{Binding}"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="E_xit" Command="{Binding ExitApplicationCommand}"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="_Track Sections" Command="{Binding OpenTrackSectionListWindowCommand}" CommandParameter="{Binding}"></MenuItem>
                <MenuItem Header="_Pit Lane Sections" Command="{Binding OpenPitLaneSectionListWindowCommand}" CommandParameter="{Binding}"></MenuItem>
                <MenuItem Header="_Computer Car Racing Line" Command="{Binding OpenComputerCarRacingLineWindowCommand}" CommandParameter="{Binding}"></MenuItem>
                <MenuItem Header="_Object Settings" Command="{Binding OpenObjectSettingsListWindowCommand}" CommandParameter="{Binding}"></MenuItem>
                <MenuItem Header="Object _Shapes" Command="{Binding OpenObjectShapesListWindowCommand}" CommandParameter="{Binding}"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Validate Track" Command="{Binding ValidateTrackCommand}" CommandParameter="{Binding}"></MenuItem>
                <MenuItem Header="_Convert GP2 Track..." Command="{Binding ConvertTrackCommand}" CommandParameter="{Binding}"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View _Help" Command="{Binding HelpDocsCommand}"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="_About ArgTrack" Command="{Binding OpenAboutWindowCommand}" CommandParameter="{Binding}"></MenuItem>
            </MenuItem>
            <MenuItem Header="Debug/Hack" Visibility="{Binding DisplayDebugHackMenu}">
                <MenuItem Header="Drawing">
                    <MenuItem IsCheckable="True" IsChecked="{Binding DrawCircleCenterIndicators}" Header="Circle Centers Track"></MenuItem>
                    <MenuItem IsCheckable="True" IsChecked="{Binding DrawLineAlongTrackCenter}" Header="Track Center Line"></MenuItem>
                    <MenuItem IsCheckable="True" IsChecked="{Binding DrawLineBetweenSectionCenters}" Header="Track Center Section Points"></MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"></ColumnDefinition>
                <ColumnDefinition Width="5"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <!--<RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="140"></RowDefinition>-->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="{Binding VisibleAtStartup}">
                    No track has been loaded!
                </TextBlock>
                <TreeView Grid.Row="0" Margin="0" Visibility="{Binding VisibleWhenTrackHasBeenLoaded}"
                          SelectedItemChanged="TreeView_OnSelectedItemChanged">

                    <!-- Track Layout -->
                    <TreeViewItem Header="Track Layout" Margin="0,3" IsExpanded="True">
                        <TreeViewItem Header="Misc Settings" Margin="0,0"
                                  MouseDoubleClick="TrackLayoutTreeView_OnMouseDoubleClick">
                        </TreeViewItem>

                        <!-- Track Layout > Track Sections -->
                        <TreeViewItem Header="Track Sections" Margin="0,3"
                                  ItemsSource="{Binding TrackViewModel.TrackSections}"
                                  MouseDoubleClick="TrackSectionTreeView_OnMouseDoubleClick"
                                  PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
                            <TreeViewItem.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add New Section" Command="{Binding TrackViewModel.TrackSections.AddNewTrackSectionCommand}" CommandParameter="{Binding Path=TrackViewModel.TrackSections}"></MenuItem>
                                </ContextMenu>
                            </TreeViewItem.ContextMenu>
                        </TreeViewItem>

                        <!-- Track Layout > Pit Lane Sections -->
                        <TreeViewItem Header="Pit Lane Sections" Margin="0,0"
                                  ItemsSource="{Binding TrackViewModel.PitLaneSections}"
                                  MouseDoubleClick="TrackSectionTreeView_OnMouseDoubleClick"
                                  PreviewMouseRightButtonDown="PitLaneOnPreviewMouseRightButtonDown">
                            <TreeViewItem.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add New Section" Command="{Binding TrackViewModel.PitLaneSections.AddNewTrackSectionCommand}" CommandParameter="{Binding Path=TrackViewModel.PitLaneSections}"></MenuItem>
                                </ContextMenu>
                            </TreeViewItem.ContextMenu>
                        </TreeViewItem>
                    </TreeViewItem>

                    <!-- Computer Cars -->
                    <TreeViewItem Header="Computer Cars" Margin="0,3" IsExpanded="True">
                        <TreeViewItem Header="Racing Line Header" Margin="0,3"
                            MouseDoubleClick="ComputerCarsRacingLineHeader_OnMouseDoubleClick">
                        </TreeViewItem>

                        <TreeViewItem Header="Racing Line Segments" Margin="0,3"
                                  ItemsSource="{Binding TrackViewModel.BestLineSegments}"
                                  MouseDoubleClick="ComputerCarsRacingLine_OnMouseDoubleClick"
                                  PreviewMouseRightButtonDown="ComputerCarsRacingLine_OnPreviewMouseRightButtonDown">
                            <TreeViewItem.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add New Segment" Command="{Binding TrackViewModel.BestLineSegments.AddComputerCarLineSegmentCommand}" CommandParameter="{Binding Path=TrackViewModel.BestLineSegments}"></MenuItem>
                                </ContextMenu>
                            </TreeViewItem.ContextMenu>
                        </TreeViewItem>
                        <TreeViewItem Header="Car Setup" Margin="0,3"
                                      MouseDoubleClick="ComputerCarsSetup_OnMouseDoubleClick"></TreeViewItem>
                        <TreeViewItem Header="Behavior" Margin="0,3"
                                      MouseDoubleClick="ComputerCarsBehavior_OnMouseDoubleClick"></TreeViewItem>

                        <TreeViewItem.Resources>
                            <!-- Computer Cars context menu -->
                            <DataTemplate DataType="{x:Type racingLine:BestLineSegmentViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="-16,3,0,3">
                                    <Image Width="16" Height="16" Margin="0" Source="{Binding Icon, Converter={StaticResource IconEnumToImageConverter}}"></Image>
                                    <TextBlock Text="Length: "></TextBlock>
                                    <TextBlock Text="{Binding Length}" />
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" Command="{Binding ParentList.EditComputerCarLineSegmentCommand}" CommandParameter="{Binding}"></MenuItem>
                                            <Separator></Separator>
                                            <MenuItem Header="Add New Segment" Command="{Binding ParentList.AddComputerCarLineSegmentCommand}" CommandParameter="{Binding Path=ParentList}"></MenuItem>
                                            <MenuItem Header="Insert New Segment Before" Command="{Binding ParentList.InsertNewComputerCarLineSegmentBeforeCommand}" CommandParameter="{Binding Path=ParentList}"></MenuItem>
                                            <MenuItem Header="Insert New Segment After" Command="{Binding ParentList.InsertNewComputerCarLineSegmentAfterCommand}" CommandParameter="{Binding Path=ParentList}"></MenuItem>
                                            <Separator></Separator>
                                            <MenuItem Header="Remove Segment" Command="{Binding ParentList.RemoveComputerCarLineSegmentCommand}" CommandParameter="{Binding}"></MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </DataTemplate>
                        </TreeViewItem.Resources>
                    </TreeViewItem>


                    <!-- Objects -->
                    <TreeViewItem Header="Objects" Margin="0,3" IsExpanded="True">
                        <TreeViewItem Header="Object Settings" Margin="0,3"
                                  ItemsSource="{Binding TrackViewModel.TrackObjectSettings}"
                                  MouseDoubleClick="ObjectSettingsTreeView_OnMouseDoubleClick" />
                        <TreeViewItem Header="Object Shapes" Margin="0,3"
                                  ItemsSource="{Binding TrackViewModel.TrackObjectShapes}"
                                  MouseDoubleClick="ObjectShapesTreeView_OnMouseDoubleClick"/>
                        <TreeViewItem.Resources>
                            <DataTemplate DataType="{x:Type objectSettings:TrackObjectSettingsViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="-16,3,0,3">
                                    <Image Width="16" Height="16" Margin="0" Source="/Resources/object-setting.png"></Image>
                                    <TextBlock Text="Offset: "></TextBlock>
                                    <TextBlock Text="{Binding Offset}" />
                                    <TextBlock Text=" Id: "></TextBlock>
                                    <TextBlock Text="{Binding Id}" />
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" Command="{Binding Edit}" CommandParameter="{Binding}"></MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type objectShapes:TrackObjectShapeViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="-16,3,0,3">
                                    <Image Width="16" Height="16" Margin="0" Source="/Resources/object-shape.png"></Image>
                                    <TextBlock Text="Id: "></TextBlock>
                                    <TextBlock Text="{Binding Id}" />
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" Command="{Binding Edit}" CommandParameter="{Binding}"></MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </DataTemplate>
                        </TreeViewItem.Resources>
                    </TreeViewItem>


                    <!-- Horizon -->
                    <TreeViewItem Header="Horizon" Margin="0,3"
                                  MouseDoubleClick="TrackHorizonTreeView_OnMouseDoubleClick" />


                    <!-- Cameras -->
                    <TreeViewItem Header="Cameras" Margin="0,3"
                                MouseDoubleClick="CameraCommandsTreeView_OnMouseDoubleClick" />


                    <!-- Misc Data -->
                    <TreeViewItem Header="Misc Data" Margin="0,3" IsExpanded="True">
                        <TreeViewItem Header="World Location" Margin="0,3" IsExpanded="False"
                                      MouseDoubleClick="TrackMiscDataTreeView_OnMouseDoubleClick" />
                        <TreeViewItem Header="Car Settings" Margin="0,3" IsExpanded="False"
                                      MouseDoubleClick="TrackMiscDataCarSettingsTreeView_OnMouseDoubleClick" />
                    </TreeViewItem>


                    <TreeView.Resources>
                        <!-- Track Section Context menu -->
                        <DataTemplate DataType="{x:Type trackSection:TrackSectionViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="-16,3,0,3" Background="Transparent">
                                <Image Width="16" Height="16" Margin="0" Source="{Binding Icon, Converter={StaticResource IconEnumToImageConverter}}"></Image>
                                <TextBlock Text="Length: "></TextBlock>
                                <TextBlock Text="{Binding Length}" Width="20" Margin="0,0,10,0" TextAlignment="Right" />
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit" Command="{Binding ParentList.EditTrackSectionCommand}" CommandParameter="{Binding}"></MenuItem>
                                        <Separator></Separator>
                                        <MenuItem Header="Add New Section" Command="{Binding ParentList.AddNewTrackSectionCommand}" CommandParameter="{Binding Path=ParentList}"></MenuItem>
                                        <MenuItem Header="Insert New Section Before" Command="{Binding ParentList.InsertNewTrackSectionBeforeCommand}" CommandParameter="{Binding Path=ParentList}"></MenuItem>
                                        <MenuItem Header="Insert New Section After" Command="{Binding ParentList.InsertNewTrackSectionAfterCommand}" CommandParameter="{Binding Path=ParentList}"></MenuItem>
                                        <Separator></Separator>
                                        <MenuItem Header="Remove Section" Command="{Binding ParentList.RemoveTrackSection}" CommandParameter="{Binding}"></MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- TODO: get this working when you feel like it -->
                <!--<GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"></GridSplitter>

                <ContentControl Grid.Row="2" Content="{Binding SelectedTreeViewItem}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type track:TrackObjectSettingsViewModel}">
                            <Label>HEJ</Label>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>-->

                <!--<StackPanel Grid.Row="2"></StackPanel>-->
                <!--<ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedTreeViewItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type track:TrackSectionViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="3">
                                <TextBlock Text="Length: "></TextBlock>
                                <TextBlock Text="{Binding Length}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>-->
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"></GridSplitter>

            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Margin="0,50,0,0" Visibility="{Binding VisibleAtStartup}">
                No track has been loaded!
            </TextBlock>
            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="32" Margin="0,0,18,0"
                        Background="#ddd" Orientation="Horizontal" ZIndex="1" Visibility="{Binding VisibleWhenTrackHasBeenLoaded}">
                <TextBlock Margin="4,8">Draw</TextBlock>
                <CheckBox Margin="8,8,16,0" IsChecked="{Binding DrawTrack}">Track</CheckBox>
                <CheckBox Margin="2,8,16,0" IsChecked="{Binding DrawPitLane}">Pit Lane</CheckBox>
                <CheckBox Margin="2,8,16,0" IsChecked="{Binding DrawVerges}">Verges</CheckBox>
                <CheckBox Margin="2,8,16,0" IsChecked="{Binding DrawTrackSideObjects}">Track-Side Objects</CheckBox>
                <Button Width="50" Height="22" Margin="32,2,16,2" Background="#eee" Command="{Binding TrackLayoutViewModel.RedrawViewCommand}" CommandParameter="{Binding TrackLayoutViewModel}">Refresh</Button>
                <Button Width="26" Height="22" Margin="2" Background="#eee" Command="{Binding TrackLayoutViewModel.ZoomTrackViewInCommand}" CommandParameter="{Binding TrackLayoutViewModel}">+</Button>
                <Button Width="26" Height="22" Margin="2" Background="#eee" Command="{Binding TrackLayoutViewModel.ZoomTrackViewOutCommand}" CommandParameter="{Binding TrackLayoutViewModel}">-</Button>
            </StackPanel>
            <Grid Grid.Column="2" Margin="0,30,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="GridGrid" LayoutUpdated="GridGrid_OnLayoutUpdated"
                  DataContext="{Binding TrackLayoutViewModel}" Background="{Binding SurroundingAreaColor}">

                <ScrollBar Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,0,18"
                           Minimum="{Binding ScrollMinY}" Maximum="{Binding ScrollMaxY}"
                           ViewportSize="{Binding ScrollHeight}" Value="{Binding OffsetY}">
                </ScrollBar>
                <ScrollBar Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,18,0"
                           Minimum="{Binding ScrollMinX}" Maximum="{Binding ScrollMaxX}"
                           ViewportSize="{Binding ScrollWidth}" Value="{Binding OffsetX}"></ScrollBar>
                <Grid ClipToBounds="True" Margin="0,0,18,18">
                    <!-- debugging stuff!
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">ViewportWidth: </TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ViewportWidth}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">ViewportHeight: </TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ViewportHeight}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                                <TextBlock HorizontalAlignment="Left" Width="80" Foreground="White">ScrollMinX:</TextBlock>
                                <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ScrollMinX}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="80" Foreground="White">ScrollMaxX: </TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ScrollMaxX}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="80" Foreground="White">OffsetX: </TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding OffsetX}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">ScrollMinY:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ScrollMinY}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">ScrollMaxY:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ScrollMaxY}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">ScrollHeight:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ScrollHeight}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">OffsetY:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding OffsetY}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">ZoomFactor:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding ZoomFactor}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="105" Foreground="White">TrackRenderWidth:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding TrackRenderWidth}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="105" Foreground="White">TrackRenderHeight:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding TrackRenderHeight}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">CenterPoint.X:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding CenterPoint.X}"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock HorizontalAlignment="Left" Width="90" Foreground="White">CenterPoint.Y:</TextBlock>
                            <TextBlock HorizontalAlignment="Left" Width="100" Foreground="White" Text="{Binding CenterPoint.Y}"></TextBlock>
                        </StackPanel>
                    </StackPanel>-->
                    <!-- end of debugging stuff -->
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <!-- M11,M12,M21,M22,OffsetX,OffsetY -->
                                <!-- 1 0 0 -1 0 0 -->
                                <!--<MatrixTransform Matrix="1 0 0 -1 0 0">-->
                                <MatrixTransform Matrix="{Binding Matrix}">
                                    <!--<MatrixTransform.Matrix>
                                        <Matrix M11="1.0" M12="0.0"
                                                M21="0.0" M22="-1.0"
                                                OffsetX="{Binding OffsetX}"
                                                OffsetY="{Binding OffsetY}"></Matrix>
                                    </MatrixTransform.Matrix>-->
                                </MatrixTransform>
                                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"></ScaleTransform>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <ItemsControl ItemsSource="{Binding TrackData}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Polyline Points="{Binding Points}"
                                      Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                      Fill="{Binding Fill}">
                                    </Polyline>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Polyline Points="{Binding SelectedTrackSection.Points}"
                            Stroke="{Binding SelectedTrackSection.Stroke}" StrokeThickness="{Binding SelectedTrackSection.StrokeThickness}"
                            Fill="{Binding SelectedTrackSection.Fill}">
                        </Polyline>
                    </Canvas>
                </Grid>
                <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#BBB"></Grid>
                <!--Background="#888"-->
            </Grid>

        </Grid>

    </Grid>
</Window>
