<Window x:Class="ArgTrack.Features.TrackEditing.ObjectShapes.EditTrackObjectShapeVectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArgTrack.Features.TrackEditing.ObjectShapes"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:EditableShapeVectorViewModel, IsDesignTimeCreatable=True}"
        Title="Vector" Width="280" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <StackPanel Orientation="Horizontal">
                <Label Width="80">From</Label>
                <ComboBox Width="180" Height="22"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value"
                          ItemsSource="{Binding AvailablePoints}" SelectedValue="{Binding From}"></ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="80">To</Label>
                <ComboBox Width="180" Height="22"
                          DisplayMemberPath="DisplayValue" SelectedValuePath="Value"
                          ItemsSource="{Binding AvailablePoints}" SelectedValue="{Binding To}"></ComboBox>
            </StackPanel>

        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick" Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick" Content="Cancel"></Button>
        </StackPanel>

    </Grid>

</Window>
