<Window x:Class="ArgTrack.Features.TrackEditing.ObjectShapes.EditTrackShapeScaleValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:objectShapes="clr-namespace:ArgTrack.Features.TrackEditing.ObjectShapes"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=objectShapes:EditableScaleValueDataViewModel, IsDesignTimeCreatable=False}"
        d:DesignWidth="260" d:DesignHeight="160"
        Width="260" Height="160"
        Title="Object Shape Scale Value"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <StackPanel Orientation="Horizontal">
                <Label Width="180">Value</Label>
                <TextBox Width="60" Height="22" Text="{Binding Value}"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="180">HexValue</Label>
                <TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding HexValue}"></TextBox>
            </StackPanel>

        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>
</Window>
