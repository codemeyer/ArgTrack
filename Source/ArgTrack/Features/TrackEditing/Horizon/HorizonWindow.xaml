<Window x:Class="ArgTrack.Features.TrackEditing.Horizon.HorizonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:horizon="clr-namespace:ArgTrack.Features.TrackEditing.Horizon"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=horizon:HorizonEditingViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Width="820" Height="440"
        Title="Horizon">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5">
                <Button Width="100" Margin="5,0,0,0" Height="24"
                    Command="{Binding UpdateHorizonFromFileCommand}" CommandParameter="{Binding}">
                    Load Horizon
                </Button>
                <Button Width="100" Margin="3,0,0,0" Height="24"
                    Command="{Binding SaveHorizonToFileCommand}" CommandParameter="{Binding}">
                    Save Horizon
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Label>1x</Label>
                <Image Source="{Binding HorizonImage}" Width="512" Height="8"></Image>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Label>8x</Label>
                    <Image VerticalAlignment="Top" Stretch="None" Source="{Binding HorizonImage}"></Image>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>
    </Grid>
</Window>
