<Window x:Class="ArgTrack.Features.TrackEditing.TrackSection.TrackSectionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:trackSection="clr-namespace:ArgTrack.Features.TrackEditing.TrackSection"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=trackSection:TrackSectionViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="664" d:DesignHeight="530"
        Width="664" Height="580"
        Title="Track Section Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <StackPanel Orientation="Vertical" Margin="5">

            <GroupBox Margin="0,0,0,0" Header="Section Info">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"></ColumnDefinition>
                        <ColumnDefinition Width="360"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Label Width="165">Length</Label>
                            <TextBox Width="60" Height="22" Text="{Binding Length}"></TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Label Width="165">Height Change</Label>
                            <TextBox Width="60" Height="22" Text="{Binding Height}"></TextBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Label Width="165">Curvature</Label>
                            <TextBox Width="60" Height="22" Text="{Binding Curvature}"></TextBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Width="360">
                        <StackPanel Orientation="Horizontal">
                            <Label Margin="-25,0,0,0" Width="165" Height="26" Content="{Binding LengthDescription}"></Label>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                            <Label Width="140">Verge End Width Left</Label>
                            <TextBox Width="60" Height="22" Text="{Binding LeftVergeWidth}"></TextBox>
                            <!--<Label Width="45" Margin="20,0,0,0">Right</Label>
                            <TextBox Width="60" Height="22" Text="{Binding RightVergeWidth}"></TextBox>-->
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Label Width="140">Verge End Width Right</Label>
                            <TextBox Width="60" Height="22" Text="{Binding RightVergeWidth}"></TextBox>
                            <!--<Label Width="45" Margin="20,0,0,0">Right</Label>
                            <TextBox Width="60" Height="22" Text="{Binding LeftVergeWidth}"></TextBox>-->
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="163"></ColumnDefinition>
                    <ColumnDefinition Width="163"></ColumnDefinition>
                    <ColumnDefinition Width="163"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Margin="0,5,5,0" Header="Kerbs">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Margin="3,5,3,3" IsChecked="{Binding HasLeftKerb}">Left Kerb</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding HasRightKerb}">Right Kerb</CheckBox>
                        <StackPanel Margin="3" Orientation="Horizontal">
                            <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding AvailableKerbHeights}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding KerbHeight}" Width="90" Height="22" IsTabStop="True" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Margin="0,5,5,0" Header="Walls/Fences">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Margin="3,5,3,3" IsChecked="{Binding BridgedLeftFence}">Bridge Left</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding RemoveLeftWall}">Remove Left</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding BridgedRightFence}">Bridge Right</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding RemoveRightWall}">Remove Right</CheckBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Margin="0,5,5,0" Header="Road Signs">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Margin="3,5,3,3" IsChecked="{Binding RoadSigns}">300/200/100</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding RoadSignArrow100}">Arrow/100</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding RoadSignArrow}">Arrow</CheckBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="3" Margin="0,5,0,0" Header="Misc">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Margin="3,5,3,3" IsChecked="{Binding PitLaneEntrance}">Pit Lane "Entrance"</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding PitLaneExit}">Pit Lane "Exit"</CheckBox>
                        <CheckBox Margin="3" IsChecked="{Binding Unknown3}">Unknown</CheckBox>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Margin="0,5" Header="Commands" Height="280">
                <StackPanel Orientation="Vertical">
                <ListView VerticalAlignment="Top" Margin="0,5,0,0" ItemsSource="{Binding Commands}" SelectedIndex="{Binding SelectedTrackCommandIndex}" IsSynchronizedWithCurrentItem="True"
                      MouseDoubleClick="Control_OnMouseDoubleClick" Height="200">
                    <!--<ListView.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding EditTrackSectionCommand}"
                                CommandParameter="{Binding TrackSections/}"></KeyBinding>
                </ListView.InputBindings>-->
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Cmd" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding CommandDisplay}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Description" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Left" Text="{Binding Description}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--<GridViewColumn Header="Args#" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments.Count}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>-->

                            <GridViewColumn Header="Arg0" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments[0].Value}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Arguments[0].Description}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Arg1" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments[1].Value}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Arguments[1].Description}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Arg2" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments[2].Value}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Arguments[2].Description}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Arg3" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments[3].Value}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Arguments[3].Description}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Arg4" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments[4].Value}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Arguments[4].Description}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Arg5" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Arguments[5].Value}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Arguments[5].Description}" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--<GridViewColumn Header="Curvature" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Curvature}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding CurvatureDescription}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Left Verge" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding LeftVergeWidth}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>


                        <GridViewColumn Header="Right Verge" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding RightVergeWidth}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Cmds#" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Commands.Count}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Description" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>-->
                        </GridView>
                    </ListView.View>
                    <!--<ListView.ItemTemplate>
                <DataTemplate>
                    <WrapPanel>
                        <TextBlock Text="Length: " />
                        <TextBlock Text="{Binding Length}" FontWeight="Bold" />
                    </WrapPanel>
                </DataTemplate>
            </ListView.ItemTemplate>-->
                </ListView>
                    <StackPanel Orientation="Horizontal">
                        <Label>Add Command of Type:</Label>
                        <ComboBox Margin="3" Height="22" Width="200" ItemsSource="{Binding AvailableTrackCommands}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding SelectedTrackCommandValueToAdd}"></ComboBox>
                        <Button Width="60" Height="22" Command="{Binding AddTrackCommandCommand}" CommandParameter="{Binding}">Add</Button>
                        <Button Margin="25,0,0,0" Width="120" Command="{Binding DeleteTrackCommandCommand}" CommandParameter="{Binding}" Height="22">Delete Selected</Button>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>

    </Grid>
</Window>
