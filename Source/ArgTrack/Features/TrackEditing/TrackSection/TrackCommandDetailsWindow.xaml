<Window x:Class="ArgTrack.Features.TrackEditing.TrackSection.TrackCommandDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:trackSection="clr-namespace:ArgTrack.Features.TrackEditing.TrackSection"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=trackSection:TrackSectionCommandViewModel, IsDesignTimeCreatable=False}"
        d:DesignWidth="424" d:DesignHeight="330"
        Width="424" Height="430"
        Title="Track Section Command Details"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="236*"/>
            <RowDefinition Height="65*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Margin="5" Grid.RowSpan="2">

            <GroupBox Header="Command">
                <StackPanel Orientation="Horizontal">
                    <!--<Label Width="80">Command</Label>-->
                    <!--<TextBox Width="60" Height="22" IsReadOnly="True" Text="{Binding CommandDisplay}"></TextBox>-->
                    <TextBlock Margin="5,5,5,5" Text="{Binding CommandDisplay}"></TextBlock>
                    <TextBlock Margin="10,5,5,5" Width="240" Text="{Binding Description}"></TextBlock>
                    <!--<ComboBox Width="300" Margin="3" Height="22" ItemsSource="{Binding AvailableTrackCommands}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding Command}"></ComboBox>-->
                    <!-- TODO -->
                    <!-- ItemsSource="{Binding AvailableSurroundingAreas}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding SurroundingArea}" -->
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Arguments" Visibility="{Binding ShowArgumentList}">
                <StackPanel Orientation="Vertical" Margin="0,2,0,0">

                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="60" Height="20" Text="{Binding Arguments[0].Value}"></TextBox>
                        <TextBlock Margin="15,5,5,5" Width="240" Text="{Binding Arguments[0].Description}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowArg1}">
                        <TextBox Width="60" Height="20" Text="{Binding Arguments[1].Value}"></TextBox>
                        <TextBlock Margin="15,5,5,5" Width="240" Text="{Binding Arguments[1].Description}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowArg2}">
                        <TextBox Width="60" Height="20" Text="{Binding Arguments[2].Value}"></TextBox>
                        <TextBlock Margin="15,5,5,5" Width="240" Text="{Binding Arguments[2].Description}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowArg3}">
                        <TextBox Width="60" Height="20" Text="{Binding Arguments[3].Value}"></TextBox>
                        <TextBlock Margin="15,5,5,5" Width="240" Text="{Binding Arguments[3].Description}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowArg4}">
                        <TextBox Width="60" Height="20" Text="{Binding Arguments[4].Value}"></TextBox>
                        <TextBlock Margin="15,5,5,5" Width="240" Text="{Binding Arguments[4].Description}"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowArg5}">
                        <TextBox Width="60" Height="20" Text="{Binding Arguments[5].Value}"></TextBox>
                        <TextBlock Margin="15,5,5,5" Width="240" Text="{Binding Arguments[5].Description}"></TextBlock>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Object Placement" Visibility="{Binding ShowObjectPlacementDetails}">

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="5" Width="170" Text="{Binding Arguments[0].Description}"></TextBlock>
                        <TextBox Margin="5,0,0,0" Width="60" Height="20" Text="{Binding Arguments[0].Value}"></TextBox>
                        <!--<TextBlock Margin="5" Width="100" Text="{Binding Command0x80DistanceDetail}"></TextBlock>-->
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="5" Width="170" Text="{Binding Arguments[1].Description}"></TextBlock>
                        <ComboBox Margin="5,5,5,5" Width="200" ItemsSource="{Binding AvailableObjects}"
                                  DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding Arguments[1].Value}"></ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="180"></Label>
                        <!-- TODO: show details for selected item  -->
                        <Label Width="200"></Label>
                    </StackPanel>

                </StackPanel>

            </GroupBox>
        </StackPanel>

        <StackPanel Margin="0,0,5,5" Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1">
            <Button Width="70" Height="22" Margin="3" IsDefault="True" Click="OKButton_OnClick"
                    Content="OK"></Button>
            <Button Width="70" Height="22" Margin="3" IsCancel="True" Click="CancelButton_OnClick"
                    Content="Cancel"></Button>
        </StackPanel>
    </Grid>
</Window>
